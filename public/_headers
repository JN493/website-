# Security headers for every response served from the static assets (Cloudflare Workers static assets).
# Format: https://developers.cloudflare.com/workers/static-assets/headers/
# Next.js copies this file from public/ into out/ at build time.
#
# Content-Security-Policy is ENFORCING (switched from report-only on request): anything not allowed below is blocked.
# script-src needs 'unsafe-inline' because the Next.js static export uses inline scripts. Tightening it means hashes.
# style-src needs 'unsafe-inline' for inline style attributes (for example the footer map size).
# Origins allowed: Cloudflare Turnstile (challenges.cloudflare.com), Supabase (submit-form function and signed file uploads),
# Google Maps embed (www.google.com, only after "Show map" is clicked).
# Google Tag Manager + Google Analytics (no Ads features): origins from https://developers.google.com/tag-platform/security/guides/csp
# (www.googletagmanager.com, *.google-analytics.com, *.google.com).
# Cookiebot: origins from https://support.cookiebot.com/hc/en-us/articles/360018907220 (consent.cookiebot.com, consentcdn.cookiebot.com,
# imgsct.cookiebot.com), checked against the real requests (uc.js and cc.js from consent.cookiebot.com).
# script-src also allows consentcdn.cookiebot.com: on the preview uc.js loads consentcdn.cookiebot.com/consentconfig/<id>/state.js
# (blocked before this was added). Cookiebot's CSP article lists no script hosts (it expects a nonce) but documents this origin
# for connect-src and frame-src.
# Before adding any other third-party service (or GTM tags that load from other origins, such as Google Ads), add its origins here first,
# otherwise this policy will block it.
# Strict-Transport-Security is NOT set here: HSTS is set in the Cloudflare dashboard at go-live.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://consent.cookiebot.com https://consentcdn.cookiebot.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.googletagmanager.com https://*.google-analytics.com https://imgsct.cookiebot.com; font-src 'self'; connect-src 'self' https://mvivwqyrtarryoomezgp.supabase.co https://challenges.cloudflare.com https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://consentcdn.cookiebot.com https://consent.cookiebot.com; frame-src https://challenges.cloudflare.com https://www.google.com https://consentcdn.cookiebot.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Content-hashed build files (names change on every build), safe to cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
